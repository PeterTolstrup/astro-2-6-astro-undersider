---
const { data } = Astro.props;
---

<article>
  <img src={data.image}/>
  <h3>{data.name}</h3>
  <p>{data.description}</p>
  <a href=`/animals/${data.slug}`>Læs mere</a>
</article>

<style>
  article {
    max-width: 300px;
    display: flex;
    flex-direction: column;
    margin-bottom: 2rem;
  }

  img {
    width: 100%;
    height: 350px;
    margin-bottom: 1rem;
    background-color: #ddd;
    object-fit: fill;
  }
</style>
